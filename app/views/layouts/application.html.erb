<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Student Library" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <%= link_to "Student Library", root_path, class: "site-name" %>
        <span class="header-note">A Ruby on Rails class project</span>
      </div>
    </header>

    <main class="container">
      <% if notice.present? %><p class="message"><%= notice %></p><% end %>
      <% if alert.present? %><p class="message"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
